		case 3: //business administration
		  if (theory >= 50 && practical >= 35 && attend >= 80) {
            pass_status = 1;
          }
		  break;
		
		case 4: //mathematics
		  if (theory >= 60 && practical >= 40 && attend >= 75) {
            pass_status = 1;
          }
		  break;
		
		default: printf("Error! Enter number 1,2,3 or 4 only\n");
		  break; 
	}
if (dept==1 || dept==2 || dept==3 || dept==4) {

  if (pass_status==1 && theory >= 85 && practical >= 80 && attend >= 90) {
        distinction = 1; //eligible
    }
	
	printf("\n-----FINAL REPORT-----\n");
	printf("Selected Department: ");
    switch (dept) {
        case 1: 
		printf("Computer Science\n");
		printf("Applicable passing requirements: atleast 50 in theory, 40 in practical and 75%% attendance\n");//to make % show do double%
		break;
        case 2: 
