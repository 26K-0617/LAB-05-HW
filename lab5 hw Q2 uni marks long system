		printf("Applicable passing requirements: atleast 55 in theory, 45 in practical and 75%% attendance\n");
		break;
        case 3:
		printf("Business Administration\n");
		printf("Applicable passing requirements: atleast 50 in theory, 35 in practical and 80%% attendance\n");
		break;
        case 4: 
		printf("Mathematics\n"); 
		printf("Applicable passing requirements: atleast 60 in theory, 40 in practical and 75%% attendance\n");
		break;
    }
	printf("Theory Marks: %d\n", theory);
	printf("Practical Marks: %d\n", practical);
	printf("Attendance percentage: %.2f%%\n", attend);
   
	seat= theory % 3; 
	// Conditional operators for :
    printf("Final Result: %s\n", (pass_status==1) ? "Passed" : "Failed");
    printf("Distinction Eligibility: %s\n", (distinction==1) ? "Eligible" : "Not Eligible");
